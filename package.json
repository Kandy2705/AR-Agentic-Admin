{
  "name": "ar-agentic-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agentic AR administration portal - typed, dependency-free browser SPA",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "test:browser": "python3 tests/browser_smoke.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
